<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:numberpicker="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="?attr/dialogPreferredPadding"
    android:paddingRight="?attr/dialogPreferredPadding"
    android:paddingTop="@dimen/abc_dialog_padding_top_material"
    android:paddingBottom="@dimen/abc_dialog_padding_top_material"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_marginTop="16dp">
    <TextView
        android:id="@+id/tolerance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:text="@string/tolerance" />    
    <CheckBox
        android:id="@+id/jitter_filter_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_below="@id/tolerance_label" />
    <TextView
        android:id="@+id/jitter_filter_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/jitter_filter_check"
        android:layout_alignBaseline="@id/jitter_filter_check"
        android:text="@string/jitter_filter" 
        android:textAppearance="?android:attr/textAppearanceMedium"/>    
   <EditText
        android:id="@+id/jitter_filter_tolerance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_alignBaseline="@id/jitter_filter_check" 
        android:inputType="numberDecimal"/>
    <CheckBox
        android:id="@+id/simplify_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_below="@id/jitter_filter_check" />
    <TextView
        android:id="@+id/simplify_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_toRightOf="@id/simplify_check"
        android:layout_alignBaseline="@id/simplify_check"
        android:text="@string/simplify" 
        android:textAppearance="?android:attr/textAppearanceMedium"/>    
   <EditText
        android:id="@+id/simplify_tolerance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_alignBaseline="@id/simplify_check"
        android:inputType="numberDecimal" />
</RelativeLayout>