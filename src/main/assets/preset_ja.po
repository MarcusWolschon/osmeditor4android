msgstr ""

#: C:\Users\simon\git\beautified-JOSM-preset\build\temp/v4.xml:5252(list_entry:short_description|group:Shipping|preset:Seamark|value:rock)
msgid ""
"A concreted mass of stony material or coral which dries, is awash or is "
